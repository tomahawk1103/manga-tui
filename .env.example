# Credenciales de Google Cloud OAuth 2.0 (tipo "Aplicación de escritorio / Desktop App")
# Copia este archivo como `.env` para compilar manga-tui con inicio de sesión con Google en 1 clic.
# El archivo `.env` está ignorado por git para no filtrar credenciales.
MANGA_TUI_GDRIVE_CLIENT_ID=
MANGA_TUI_GDRIVE_CLIENT_SECRET=

# Credenciales de MyAnimeList OAuth 2.0 (https://myanimelist.net/apiconfig)
# App Type: "other" | App Redirect URL: http://127.0.0.1:8765/callback
MANGA_TUI_MAL_CLIENT_ID=
# Opcional (normalmente vacío para App Type "other"):
MANGA_TUI_MAL_CLIENT_SECRET=
